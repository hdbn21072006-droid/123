# Production Environment Variables
# Copy this file to .env and fill in your actual values

# App Configuration
APP_CONFIG_APP_VERSION=231130
APP_CONFIG_TEN_TRUONG='VIỆN KHOA HỌC KỸ THUẬT BƯU ĐIỆN'
APP_CONFIG_TIEN_TO_TRUONG='Học viện'
APP_CONFIG_TEN_TRUONG_VIET_TAT_TIENG_ANH=RIPT
APP_CONFIG_PRIMARY_COLOR=#CC0D00

# Backend Configuration
BACKEND_PORT=8080
NODE_ENV=production

# Database Configuration (TiDB Cloud / Aiven MySQL)
# For TiDB Cloud:
# DB_HOST=gateway.region.tidbcloud.com
# DB_PORT=4000
# For Aiven MySQL:
# DB_HOST=your-project.aivencloud.com
# DB_PORT=port_number
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=student_management

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP Configuration
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# AI / LLM Configuration
LLM_PROVIDER=gemini

# Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Model names
GEMINI_MODEL=gemini-2.0-flash

# Chat configuration
MAX_HISTORY_PAIRS=10
TOP_K_CHUNKS=5

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://your-netlify-app.netlify.app,http://localhost:8000
